# ============================================================
# .env.production.example
# Copy these into Render → Environment tab (NOT into a file)
# ============================================================

# ── Server ───────────────────────────────────────────────────
NODE_ENV=production
# PORT is set automatically by Render — do NOT set it manually

# ── Database (Supabase) ──────────────────────────────────────
# Found in: Supabase → Settings → Database → Connection string
# Use the "Transaction" pooler (port 6543) tab, then append params:
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# ── Authentication ───────────────────────────────────────────
# Generate with:  openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ── Email (Gmail via nodemailer) ─────────────────────────────
# Gmail App Password setup:
#   1. Google Account → Security → 2-Step Verification (enable it)
#   2. Security → App Passwords → create one named "SMS Backend"
#   3. Copy the 16-character password (no spaces) into SMTP_PASS
EMAIL_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx     # 16-char app password
EMAIL_FROM=SMS No-Reply <noreply@yourdomain.com>

# ── Frontend CORS ────────────────────────────────────────────
# Comma-separated if you have multiple (e.g. Vercel preview + production)
CLIENT_URL=https://your-frontend.vercel.app,https://your-preview.vercel.app
