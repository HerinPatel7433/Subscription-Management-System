{
  "info": {
    "_postman_id": "sms-api-collection-v1",
    "name": "Subscription Management System — API",
    "description": "Complete REST API collection for the Subscription Management System.\n\n## Setup\n1. Set the `base_url` variable to `http://localhost:5000`\n2. Run **Auth > Signup** or **Auth > Login** — the token is auto-saved to `jwt_token`\n3. All protected requests use `{{jwt_token}}` automatically via collection auth\n\n## Variables\n- `base_url` — API base URL (default: http://localhost:5000)\n- `jwt_token` — auto-populated by login/signup scripts\n- `product_id` — auto-populated by Create Product\n- `variant_id` — auto-populated by Add Variant\n- `plan_id` — auto-populated by Create Plan",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000", "type": "string" },
    { "key": "jwt_token", "value": "", "type": "string" },
    { "key": "product_id", "value": "", "type": "string" },
    { "key": "variant_id", "value": "", "type": "string" },
    { "key": "plan_id", "value": "", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "Signup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('jwt_token', body.token);",
                  "  pm.test('Signup successful', () => pm.response.to.have.status(201));",
                  "  pm.test('Token returned', () => pm.expect(body.token).to.be.a('string'));",
                  "  pm.test('Password not exposed', () => pm.expect(body.user.passwordHash).to.be.undefined);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Teesh Patel\",\n  \"email\": \"teesh@sms.com\",\n  \"password\": \"Admin@1234\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/signup", "host": ["{{base_url}}"], "path": ["api", "auth", "signup"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('jwt_token', body.token);",
                  "  pm.test('Login successful', () => pm.response.to.have.status(200));",
                  "  pm.test('Token returned', () => pm.expect(body.token).to.be.a('string'));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teesh@sms.com\",\n  \"password\": \"Admin@1234\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Login — Invalid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401', () => pm.response.to.have.status(401));",
                  "pm.test('Error message present', () => pm.expect(pm.response.json().message).to.be.a('string'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teesh@sms.com\",\n  \"password\": \"WrongPassword!\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Signup — Weak Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 400', () => pm.response.to.have.status(400));",
                  "pm.test('Validation errors present', () => pm.expect(pm.response.json().errors).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"weak@sms.com\",\n  \"password\": \"short\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/signup", "host": ["{{base_url}}"], "path": ["api", "auth", "signup"] }
          }
        },
        {
          "name": "Request Password Reset",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teesh@sms.com\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/reset-password/request", "host": ["{{base_url}}"], "path": ["api", "auth", "reset-password", "request"] }
          }
        },
        {
          "name": "Confirm Password Reset",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"PASTE_TOKEN_FROM_EMAIL_HERE\",\n  \"password\": \"NewAdmin@5678\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/reset-password/confirm", "host": ["{{base_url}}"], "path": ["api", "auth", "reset-password", "confirm"] }
          }
        }
      ]
    },
